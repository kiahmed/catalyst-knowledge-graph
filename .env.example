# Catalyst knowledge-graph local dev config (Robotics module).
# Copy to .env (gitignored) and fill in.

# ── Sector (Phase 1 = Robotics) ─────────────────────────────────────
SECTOR=Robotics

# ── Arboryx (sibling arboryx.ai repo) — Firestore source of truth ───
# Arboryx writes findings to `findings/{entry_id}` in Firestore.
# Project + (default) database; same SA we use for read needs
# `roles/datastore.user` added.
GCP_PROJECT=sample-gcp-project-id
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=findings

# ── Robotics module export → Firestore + Firebase Storage ───────────
# Where this module publishes its output for the Firebase-hosted frontend.
# Off in local dev by default; flip to true in prod.
FIRESTORE_EXPORT_ENABLED=false
FIRESTORE_EXPORT_COLLECTION=CKG-Robotics
# Card-PNG bucket. Private — frontend reads via the Firebase Storage SDK,
# not a public URL. Leave empty locally; prod sets it via Terraform.
STORAGE_UPLOAD_ENABLED=false
STORAGE_BUCKET=
STORAGE_CARDS_PREFIX=cards

# ── GCP auth ────────────────────────────────────────────────────────
# Uses $GOOGLE_APPLICATION_CREDENTIALS from your shell — no var needed here.
# Compose mounts that file at /secrets/gcs-sa.json inside the container.
# Prereq (one-time):  gcloud auth application-default login
# OR point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON file.


# ── LLM auth + model ────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Postiz (sibling soljet-postiz repo) ─────────────────────────────
# For local dev, point at the Postiz container via host.docker.internal
POSTIZ_BASE_URL=http://host.docker.internal:4007
POSTIZ_API_KEY=
POSTIZ_CHANNELS=twitter,linkedin
DAILY_POST_CAP=3
MIN_CONFIDENCE=0.75

# ── Frontend data source ────────────────────────────────────────────
# Where the graph page reads card data from.
#   "nginx"     → /cards.json served by the local nginx container (today)
#   "firestore" → direct read from Firestore via Firebase Web SDK (post-deploy)
FRONTEND_DATA_SOURCE=nginx

# ── Frontend Firebase (pre-wired; uncomment when flipping to firestore) ──
# Public client config — safe to ship to the browser. Lock the actual
# read access via Firestore Security Rules, NOT by hiding these values.
# Copy frontend/firebase-config.js.example → frontend/firebase-config.js
# and fill these in before flipping FRONTEND_DATA_SOURCE=firestore.
# FIREBASE_PROJECT=sample-gcp-project-id
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=sample-gcp-project-id.firebaseapp.com
# FIREBASE_APP_ID=

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Host port overrides ─────────────────────────────────────────────
# Container-internal ports are fixed (8080/8081/8082/80); these control
# what the host exposes. Change ONLY if a port is already taken on the
# host. Verify with `make doctor` before `make up`.
INGEST_PORT=8080
RENDER_PORT=8081
SOCIAL_PORT=8082
FRONTEND_PORT=8000

# ── Preflight thresholds ────────────────────────────────────────────
# Minimum Docker daemon memory in MiB. Playwright/Chromium + DuckDB
# + LLM client together want ~4GB headroom.
MIN_DOCKER_MEM_MB=4096
