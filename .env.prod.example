# ════════════════════════════════════════════════════════════════════
# Catalyst-knowledge-graph — PROD deployment config TEMPLATE.
#
# Copy to .env.prod (gitignored) and fill in. `make deploy` reads .env.prod
# and does everything downstream:
#   - infra keys  → tools/infra/prod.auto.tfvars   (generated; Terraform)
#   - secret keys → Secret Manager                 (never in Terraform state)
#   then builds/pushes the container artifacts and runs `terraform apply`.
#
# You never hand-edit cloud_run.tf / cloud_functions.tf / *.tfvars.
#
# Prod *behaviour* flags (FIRESTORE_EXPORT_ENABLED, STORAGE_UPLOAD_ENABLED,
# STORAGE_BUCKET, DUCKDB_GCS_BUCKET) are fixed ON in the Terraform module —
# not per-deploy knobs, so they are intentionally NOT listed here.
# ════════════════════════════════════════════════════════════════════

# ── GCP project + region ────────────────────────────────────────────
GCP_PROJECT=
REGION=us-central1

# ── Sector (drives the CKG-<SECTOR> export collection name) ─────────
SECTOR=Robotics

# ── Buckets ─────────────────────────────────────────────────────────
# DATA_BUCKET  : private — DuckDB file + JSON exports + function sources.
# CARDS_BUCKET : public  — card PNGs the Firebase frontend fetches.
DATA_BUCKET=robotics-data
CARDS_BUCKET=robotics-cards

# ── Cloud Scheduler (UTC cron) ──────────────────────────────────────
INGEST_SCHEDULE="0 6 * * *"
# SOCIAL_SCHEDULE (retired 2026-07-05 — no longer read by deploy)

# ── Container image tag (make deploy overrides with the git SHA) ────
IMAGE_TAG=latest

# ── Secrets → Secret Manager (never written to Terraform state) ─────
GEMINI_API_KEY=
# POSTIZ_BASE_URL / POSTIZ_API_KEY (retired 2026-07-05 — no longer read by
# deploy; social posting moved to soljet-postiz)

# ── Firebase deploy credential (for make deploy-frontend) ───────────
# Path to a service-account key JSON. Created + recorded by `make firebase-sa`;
# leave blank until you run it. firebase-tools authenticates from this — no
# browser, no expiry.
FIREBASE_DEPLOY_KEY=

# ── Custom domain (for make link-domain) ────────────────────────────
# Links the Firebase Hosting site to a subdomain via Cloudflare DNS.
# CF_API_TOKEN: create at Cloudflare → My Profile → API Tokens → Create →
# "Edit zone DNS" template, scoped to the CF_ZONE_NAME zone. Leave blank
# until you have it. CUSTOM_DOMAIN must sit under CF_ZONE_NAME.
CUSTOM_DOMAIN=robotics.arboryx.ai
CF_ZONE_NAME=arboryx.ai
CF_API_TOKEN=
