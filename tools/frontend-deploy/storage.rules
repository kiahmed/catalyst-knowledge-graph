rules_version = '2';

// Card PNGs — gs://<cards bucket>/cards/*.
//
// The bucket is PRIVATE (no allUsers IAM). Two access paths:
//   - robotics-render uploads via the GCS API as a service account, which
//     bypasses these rules entirely (SA access is governed by IAM).
//   - browsers read via the Firebase Storage SDK, which enforces these rules.
//
// `request.auth != null` is satisfied by anonymous Firebase Auth — the
// frontend signs in anonymously on load. This stops drive-by bucket
// scraping and removes the public URL surface; it does not (and cannot)
// stop someone saving an image the page has already rendered for them.
service firebase.storage {
  match /b/{bucket}/o {
    match /cards/{image} {
      allow read: if request.auth != null;
      allow write: if false;   // uploads are service-account only
    }
  }
}
